@model List<AIHUBOS.Models.UserTask>
@{
    ViewData["Title"] = "Công việc của tôi";
    Layout = "~/Views/Shared/_LayoutStaff.cshtml";
}

<style>
    :root {
        --task-navy: #0F1330;
        --task-pale: #E9D9C5;
        --task-sand: #C3A387;
        --task-terracotta: #7A3F30;
        --task-golden: #D4A459;
        --task-clay: #CC7051;
        --task-success: #10B981;
        --task-warning: #F59E0B;
        --task-danger: #EF4444;
        --task-info: #3B82F6;
        --task-bg-page: #FAF8F5;
        --task-bg-card: #FFFFFF;
        --task-text-primary: #0F1330;
        --task-text-secondary: #6B7280;
        --task-border: #E9E6E1;
        --task-shadow: rgba(15, 19, 48, 0.08);
    }

    body.staff-dark-mode {
        --task-bg-page: #121523;
        --task-bg-card: #1a1d2e;
        --task-text-primary: #E9D9C5;
        --task-text-secondary: #9CA3AF;
        --task-border: #2d3142;
        --task-shadow: rgba(0, 0, 0, 0.3);
    }

    .task-page {
        padding: 32px 24px;
        background: var(--task-bg-page);
        min-height: calc(100vh - 70px);
    }

    .task-header {
        background: linear-gradient(135deg, var(--task-navy) 0%, #1a1f4a 100%);
        border-radius: 20px;
        padding: 40px;
        margin-bottom: 32px;
        box-shadow: 0 8px 24px var(--task-shadow);
        position: relative;
        overflow: hidden;
    }

        .task-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(212, 164, 89, 0.15) 0%, transparent 70%);
            animation: float 6s ease-in-out infinite;
        }

    keyframes float {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-20px);
    }

    }

    .task-header-content {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .task-header-left h1 {
        color: var(--task-pale);
        font-size: 32px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .task-header-left p {
        color: rgba(233, 217, 197, 0.8);
        font-size: 16px;
    }

    .task-stats {
        display: flex;
        gap: 24px;
    }

    .task-stat-item {
        text-align: center;
        padding: 16px 24px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border-radius: 12px;
        border: 1px solid rgba(212, 164, 89, 0.2);
    }

        .task-stat-item .number {
            font-size: 28px;
            font-weight: 800;
            color: var(--task-golden);
            margin-bottom: 4px;
        }

        .task-stat-item .label {
            font-size: 13px;
            color: rgba(233, 217, 197, 0.7);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .task-filters {
        background: var(--task-bg-card);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 2px 12px var(--task-shadow);
    }

    .filter-row {
        display: flex;
        gap: 16px;
        align-items: center;
        flex-wrap: wrap;
    }

    .filter-group {
        flex: 1;
        min-width: 200px;
    }

        .filter-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--task-text-secondary);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .filter-group select,
        .filter-group input {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid var(--task-border);
            border-radius: 10px;
            font-size: 14px;
            background: var(--task-bg-card);
            color: var(--task-text-primary);
            transition: all 0.3s ease;
        }

            .filter-group select:focus,
            .filter-group input:focus {
                outline: none;
                border-color: var(--task-golden);
                box-shadow: 0 0 0 3px rgba(212, 164, 89, 0.1);
            }

    /* ===== LIST VIEW STYLES ===== */
    .task-list-container {
        background: var(--task-bg-card);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 2px 12px var(--task-shadow);
    }

    .task-list-item {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 20px 24px;
        border-bottom: 1px solid var(--task-border);
        transition: all 0.3s ease;
        position: relative;
        cursor: pointer;
    }

        .task-list-item::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background: var(--task-golden);
            transform: scaleY(0);
            transition: transform 0.3s ease;
        }

        .task-list-item:hover {
            background: rgba(212, 164, 89, 0.05);
        }

            .task-list-item:hover::before {
                transform: scaleY(1);
            }

        .task-list-item:last-child {
            border-bottom: none;
        }

        .task-list-item.priority-high::before {
            background: var(--task-danger);
        }

        .task-list-item.priority-medium::before {
            background: var(--task-warning);
        }

        .task-list-item.priority-low::before {
            background: var(--task-success);
        }

    .task-list-priority {
        flex-shrink: 0;
        width: 80px;
    }

    .task-priority-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .priority-high {
        background: rgba(239, 68, 68, 0.1);
        color: var(--task-danger);
    }

    .priority-medium {
        background: rgba(245, 158, 11, 0.1);
        color: var(--task-warning);
    }

    .priority-low {
        background: rgba(16, 185, 129, 0.1);
        color: var(--task-success);
    }

    .task-list-content {
        flex: 1;
        min-width: 0;
    }

    .task-list-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--task-text-primary);
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .task-list-title .overdue-badge {
            background: var(--task-danger);
            color: white;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 10px;
            font-weight: 700;
            animation: pulse 2s ease-in-out infinite;
        }

    keyframes pulse {
        0%, 100%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.7;
    }

    }

    .task-list-meta {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        font-size: 13px;
        color: var(--task-text-secondary);
    }

        .task-list-meta span {
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .task-list-meta span i {
                color: var(--task-golden);
                font-size: 12px;
            }

    .task-list-status {
        flex-shrink: 0;
        width: 130px;
    }

    .task-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        width: 100%;
        justify-content: center;
    }

        .task-status-badge i {
            font-size: 12px;
        }

    .status-todo {
        background: rgba(107, 114, 128, 0.1);
        color: #6B7280;
    }

    .status-inprogress {
        background: rgba(245, 158, 11, 0.1);
        color: var(--task-warning);
    }

    .status-testing {
        background: rgba(59, 130, 246, 0.1);
        color: var(--task-info);
    }

    .status-done {
        background: rgba(16, 185, 129, 0.1);
        color: var(--task-success);
    }

    .status-reopen {
        background: rgba(239, 68, 68, 0.1);
        color: var(--task-danger);
    }

    .task-list-actions {
        flex-shrink: 0;
        display: flex;
        gap: 8px;
    }

    .task-action-btn {
        width: 40px;
        height: 40px;
        border: none;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 14px;
    }

    .task-action-btn-primary {
        background: linear-gradient(135deg, var(--task-navy) 0%, #1a1f4a 100%);
        color: var(--task-pale);
    }

        .task-action-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(15, 19, 48, 0.3);
        }

    .task-action-btn-secondary {
        background: var(--task-bg-card);
        color: var(--task-text-primary);
        border: 2px solid var(--task-border);
    }

        .task-action-btn-secondary:hover {
            border-color: var(--task-golden);
            background: rgba(212, 164, 89, 0.05);
        }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
        background: var(--task-bg-card);
        border-radius: 20px;
        box-shadow: 0 2px 12px var(--task-shadow);
    }

        .empty-state i {
            font-size: 80px;
            color: var(--task-golden);
            opacity: 0.5;
            margin-bottom: 24px;
        }

        .empty-state h3 {
            font-size: 24px;
            font-weight: 700;
            color: var(--task-text-primary);
            margin-bottom: 12px;
        }

        .empty-state p {
            font-size: 16px;
            color: var(--task-text-secondary);
        }

    media (max-width: 768px) {
        .task-header

    {
        padding: 24px;
    }

    .task-header-content {
        flex-direction: column;
        align-items: flex-start;
    }

    .task-stats {
        width: 100%;
        justify-content: space-between;
    }

    .task-stat-item {
        padding: 12px 16px;
    }

    .task-list-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        padding: 16px;
    }

    .task-list-priority,
    .task-list-status,
    .task-list-actions {
        width: 100%;
    }

    .task-list-meta {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }

    .task-list-actions {
        justify-content: stretch;
    }

    .task-action-btn {
        flex: 1;
    }

    .filter-row {
        flex-direction: column;
    }

    .filter-group {
        width: 100%;
    }

    }UpdateTaskProgressRequest
</style>

<div class="task-page">
    <!-- Header -->
    <div class="task-header">
        <div class="task-header-content">
            <div class="task-header-left">
                <h1><i class="fas fa-clipboard-list"></i> Công việc của tôi</h1>
                <p>Quản lý và theo dõi tiến độ công việc</p>
            </div>
            <div class="task-stats">
                <div class="task-stat-item">
                    <div class="number" id="totalTasks">@Model.Count</div>
                    <div class="label">Tổng số</div>
                </div>
                <div class="task-stat-item">
                    <div class="number" id="inProgressTasks">@Model.Count(t => t.Status == "InProgress")</div>
                    <div class="label">Đang làm</div>
                </div>
                <div class="task-stat-item">
                    <div class="number" id="completedTasks">@Model.Count(t => t.Status == "Done")</div>
                    <div class="label">Hoàn thành</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="task-filters">
        <div class="filter-row">
            <div class="filter-group">
                <label><i class="fas fa-filter"></i> Trạng thái</label>
                <select id="filterStatus">
                    <option value="">Tất cả</option>
                    <option value="TODO">Chưa bắt đầu</option>
                    <option value="InProgress">Đang làm</option>
                    <option value="Testing">Chờ test</option>
                    <option value="Done">Hoàn thành</option>
                    <option value="Reopen">Cần sửa lại</option>
                </select>
            </div>
            <div class="filter-group">
                <label><i class="fas fa-flag"></i> Độ ưu tiên</label>
                <select id="filterPriority">
                    <option value="">Tất cả</option>
                    <option value="High">Cao</option>
                    <option value="Medium">Trung bình</option>
                    <option value="Low">Thấp</option>
                </select>
            </div>
            <div class="filter-group">
                <label><i class="fas fa-search"></i> Tìm kiếm</label>
                <input type="text" id="searchTask" placeholder="Tìm tên công việc...">
            </div>
        </div>
    </div>

    <!-- Task List -->
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <h3>Chưa có công việc nào</h3>
            <p>Bạn chưa được giao công việc nào. Hãy liên hệ quản lý để được phân công.</p>
        </div>
    }
    else
    {
        <div class="task-list-container" id="taskList">
            @foreach (var userTask in Model)
            {
                var task = userTask.Task;
                var priorityClass = task.Priority?.ToLower() ?? "medium";
                var statusClass = (userTask.Status ?? "TODO").ToLower();
                var statusText = userTask.Status switch
                {
                    "TODO" => "Chưa bắt đầu",
                    "InProgress" => "Đang làm",
                    "Testing" => "Chờ test",
                    "Done" => "Hoàn thành",
                    "Reopen" => "Cần sửa lại",
                    _ => "Chưa bắt đầu"
                };
                var statusIcon = userTask.Status switch
                {
                    "TODO" => "inbox",
                    "InProgress" => "spinner fa-spin",
                    "Testing" => "vial",
                    "Done" => "check-circle",
                    "Reopen" => "redo",
                    _ => "inbox"
                };
                var isOverdue = task.Deadline.HasValue && DateTime.Now > task.Deadline.Value && userTask.Status != "Done";

                <div class="task-list-item priority-@priorityClass"
                     data-status="@userTask.Status"
                     data-priority="@task.Priority"
                     data-taskname="@task.TaskName">

                    <div class="task-list-priority">
                        <div class="task-priority-badge priority-@priorityClass">
                            <i class="fas fa-flag"></i>
                            @(task.Priority ?? "Medium")
                        </div>
                    </div>

                    <div class="task-list-content">
                        <div class="task-list-title">
                            <strong>@task.TaskName</strong>
                            @if (isOverdue)
                            {
                                <span class="overdue-badge">
                                    <i class="fas fa-exclamation-triangle"></i> QUÁ HẠN
                                </span>
                            }
                        </div>
                        <div class="task-list-meta">
                            <span>
                                <i class="fas fa-laptop-code"></i>
                                @(task.Platform ?? "N/A")
                            </span>
                            <span>
                                <i class="fas fa-calendar-alt"></i>
                                @(task.Deadline.HasValue ? task.Deadline.Value.ToString("dd/MM/yyyy") : "Không có deadline")
                            </span>
                            @if (!string.IsNullOrEmpty(userTask.ReportLink))
                            {
                                <span>
                                    <i class="fas fa-link"></i>
                                    Có báo cáo
                                </span>
                            }
                        </div>
                    </div>

                    <div class="task-list-status">
                        <div class="task-status-badge status-@statusClass">
                            <i class="fas fa-@statusIcon"></i>
                            <span>@statusText</span>
                        </div>
                    </div>

                    <div class="task-list-actions">
                        <button class="task-action-btn task-action-btn-primary"
                                onclick="viewTaskDetail(@userTask.UserTaskId)"
                                title="Xem chi tiết">
                            <i class="fas fa-eye"></i>
                        </button>
                        @if (userTask.Status != "Done" && userTask.Status != "Testing")
                        {
                            <button class="task-action-btn task-action-btn-secondary"
                                    onclick="updateTaskProgress(@userTask.UserTaskId)"
                                    title="Cập nhật">
                                <i class="fas fa-edit"></i>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Task Detail Modal -->
<div class="modal fade" id="taskDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chi tiết công việc</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="taskDetailContent">
                <!-- Content loaded via AJAX -->
            </div>
        </div>
    </div>
</div>

<!-- Update Progress Modal -->
<div class="modal fade" id="updateProgressModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập nhật tiến độ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="updateUserTaskId">
                <div class="mb-3">
                    <label class="form-label">Trạng thái</label>
                    <select class="form-select" id="updateStatus">
                        <option value="TODO">Chưa bắt đầu</option>
                        <option value="InProgress">Đang làm</option>
                        <option value="Testing">Gửi test</option>
                    </select>
                </div>
                <div class="mb-3" id="reportLinkGroup" style="display:none;">
                    <label class="form-label">Link báo cáo <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="updateReportLink" placeholder="https://...">
                    <small class="text-muted">Bắt buộc khi gửi test</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="submitUpdateProgress()">Cập nhật</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Filter tasks
        function filterTasks() {
            const status = document.getElementById('filterStatus').value.toLowerCase();
            const priority = document.getElementById('filterPriority').value.toLowerCase();
            const search = document.getElementById('searchTask').value.toLowerCase();

            const items = document.querySelectorAll('.task-list-item');
            let visibleCount = 0;

            items.forEach(item => {
                const itemStatus = item.getAttribute('data-status').toLowerCase();
                const itemPriority = item.getAttribute('data-priority').toLowerCase();
                const itemName = item.getAttribute('data-taskname').toLowerCase();

                const matchStatus = !status || itemStatus === status;
                const matchPriority = !priority || itemPriority === priority;
                const matchSearch = !search || itemName.includes(search);

                if (matchStatus && matchPriority && matchSearch) {
                    item.style.display = '';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            // Show empty state if no results
            const container = document.getElementById('taskList');
            if (visibleCount === 0 && items.length > 0) {
                if (!document.getElementById('noResultsState')) {
                    const emptyState = document.createElement('div');
                    emptyState.id = 'noResultsState';
                    emptyState.className = 'empty-state';
                    emptyState.innerHTML = `
                        <i class="fas fa-search"></i>
                        <h3>Không tìm thấy kết quả</h3>
                        <p>Thử thay đổi bộ lọc để tìm kiếm</p>
                    `;
                    container.after(emptyState);
                    container.style.display = 'none';
                }
            } else {
                const noResults = document.getElementById('noResultsState');
                if (noResults) {
                    noResults.remove();
                    container.style.display = 'block';
                }
            }
        }

        document.getElementById('filterStatus').addEventListener('change', filterTasks);
        document.getElementById('filterPriority').addEventListener('change', filterTasks);
        document.getElementById('searchTask').addEventListener('input', filterTasks);

        // View task detail
        async function viewTaskDetail(userTaskId) {
            try {
                const response = await fetch(`/Staff/GetTaskDetail?userTaskId=${userTaskId}`);
                const data = await response.json();

                if (data.success) {
                    const task = data.task;
                    document.getElementById('taskDetailContent').innerHTML = `
                        <div class="task-detail-view">
                            <h4>${task.taskName}</h4>
                            <p>${task.description}</p>
                            <hr>
                            <p><strong>Platform:</strong> ${task.platform}</p>
                            <p><strong>Deadline:</strong> ${task.deadline}</p>
                            <p><strong>Priority:</strong> ${task.priority}</p>
                            <p><strong>Status:</strong> <span class="badge bg-${task.statusClass}">${task.statusText}</span></p>
                            ${task.reportLink ? `<p><strong>Report Link:</strong> <a href="${task.reportLink}" target="_blank">${task.reportLink}</a></p>` : ''}
                            ${task.isOverdue ? '<div class="alert alert-danger">⚠️ Task đã quá hạn!</div>' : ''}
                        </div>
                    `;
                    new bootstrap.Modal(document.getElementById('taskDetailModal')).show();
                } else {
                    alert(data.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi tải chi tiết task');
            }
        }

        // Update task progress
        function updateTaskProgress(userTaskId) {
            document.getElementById('updateUserTaskId').value = userTaskId;
            document.getElementById('updateStatus').value = 'InProgress';
            document.getElementById('reportLinkGroup').style.display = 'none';
            new bootstrap.Modal(document.getElementById('updateProgressModal')).show();
        }

        document.getElementById('updateStatus').addEventListener('change', function() {
            if (this.value === 'Testing') {
                document.getElementById('reportLinkGroup').style.display = 'block';
            } else {
                document.getElementById('reportLinkGroup').style.display = 'none';
            }
        });

        async function submitUpdateProgress() {
            const userTaskId = parseInt(document.getElementById('updateUserTaskId').value);
            const status = document.getElementById('updateStatus').value;
            const reportLink = document.getElementById('updateReportLink').value.trim();

            /* if (status === 'Testing' && !reportLink) {
                alert('Vui lòng nhập link báo cáo khi gửi test');
                return;
            } */

            try {
                const response = await fetch('/Staff/UpdateTaskProgress', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userTaskId, status, reportLink })
                });

                const data = await response.json();
                alert(data.message);

                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('updateProgressModal')).hide();
                    location.reload();
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Có lỗi xảy ra');
            }
        }
    </script>
}