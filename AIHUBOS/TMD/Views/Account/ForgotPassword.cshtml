@{
    ViewData["Title"] = "Quên Mật Khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AIHUBOS System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* ===== FORGOT PASSWORD PAGE - CUSTOM STYLES ===== */
        /* Using prefix: .fp- (forgot-password) to avoid conflicts */

        :root {
            /* PRIMARY COLORS */
            --fp-navy: #0F1330;
            --fp-pale: #E9D9C5;
            --fp-sand: #C3A387;
            /* SECONDARY COLORS */
            --fp-terracotta: #7A3F30;
            --fp-golden: #D4A459;
            --fp-clay: #CC7051;
            /* SYSTEM COLORS */
            --fp-success: #10B981;
            --fp-danger: #EF4444;
            /* LIGHT MODE */
            --fp-bg-page: #FAF8F5;
            --fp-bg-card: #FFFFFF;
            --fp-bg-input: #FFFFFF;
            --fp-text-primary: #0F1330;
            --fp-text-secondary: #6B7280;
            --fp-text-muted: #9CA3AF;
            --fp-border: #E9E6E1;
            --fp-shadow: rgba(15, 19, 48, 0.08);
            --fp-shadow-lg: rgba(15, 19, 48, 0.15);
        }

        body.dark-mode {
            /* DARK MODE */
            --fp-bg-page: #121523;
            --fp-bg-card: #1a1d2e;
            --fp-bg-input: #252837;
            --fp-text-primary: #E9D9C5;
            --fp-text-secondary: #9CA3AF;
            --fp-text-muted: #6B7280;
            --fp-border: #2d3142;
            --fp-shadow: rgba(0, 0, 0, 0.3);
            --fp-shadow-lg: rgba(0, 0, 0, 0.5);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .fp-page {
            font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--fp-bg-page);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            transition: background 0.3s ease;
        }

        .fp-container {
            max-width: 480px;
            width: 100%;
        }

        .fp-card {
            background: var(--fp-bg-card);
            border-radius: 20px;
            box-shadow: 0 8px 32px var(--fp-shadow-lg);
            overflow: hidden;
            border: 1px solid var(--fp-border);
            animation: fp-fadeIn 0.5s ease-out;
        }

        keyframes fp-fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .fp-header {
            background: linear-gradient(135deg, var(--fp-navy) 0%, #1a1f4a 100%);
            color: var(--fp-pale);
            padding: 40px 30px;
            text-align: center;
            border-bottom: none;
            position: relative;
            overflow: hidden;
        }

            .fp-header::before {
                content: '';
                position: absolute;
                top: -50%;
                right: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle, rgba(212, 164, 89, 0.1) 0%, transparent 70%);
                animation: fp-rotate 20s linear infinite;
            }

        keyframes fp-rotate {
            from

        {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }

        }

        .fp-header-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 20px;
            background: rgba(212, 164, 89, 0.2);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid rgba(212, 164, 89, 0.3);
            position: relative;
            z-index: 1;
        }

            .fp-header-icon i {
                font-size: 36px;
                color: var(--fp-golden);
            }

        .fp-header-title {
            margin: 0 0 12px 0;
            font-weight: 700;
            font-size: 28px;
            letter-spacing: -0.5px;
            position: relative;
            z-index: 1;
        }

        .fp-header-subtitle {
            margin: 0;
            font-size: 15px;
            opacity: 0.85;
            font-weight: 400;
            position: relative;
            z-index: 1;
        }

        .fp-body {
            padding: 40px 35px;
        }

        .fp-info-box {
            background: linear-gradient(135deg, rgba(212, 164, 89, 0.08) 0%, rgba(195, 163, 135, 0.08) 100%);
            border-left: 4px solid var(--fp-golden);
            padding: 18px 20px;
            border-radius: 12px;
            margin-bottom: 28px;
            display: flex;
            align-items: flex-start;
            gap: 14px;
            box-shadow: 0 2px 8px var(--fp-shadow);
        }

        .fp-info-icon {
            color: var(--fp-golden);
            font-size: 20px;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .fp-info-text {
            color: var(--fp-text-primary);
            line-height: 1.6;
            font-size: 14px;
            margin: 0;
        }

        .fp-form-group {
            margin-bottom: 24px;
        }

        .fp-label {
            font-weight: 600;
            color: var(--fp-text-primary);
            margin-bottom: 10px;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .fp-label-icon {
            font-size: 16px;
            color: var(--fp-golden);
        }

        .fp-input {
            width: 100%;
            border: 2px solid var(--fp-border);
            border-radius: 12px;
            padding: 14px 18px;
            font-size: 15px;
            transition: all 0.25s ease;
            background: var(--fp-bg-input);
            font-family: 'Inter', 'Segoe UI', sans-serif;
            color: var(--fp-text-primary);
            outline: none;
        }

            .fp-input::placeholder {
                color: var(--fp-text-muted);
                opacity: 0.7;
            }

            .fp-input:focus {
                border-color: var(--fp-golden);
                box-shadow: 0 0 0 4px rgba(212, 164, 89, 0.15);
                background: var(--fp-bg-input);
            }

        .fp-btn {
            width: 100%;
            background: linear-gradient(135deg, var(--fp-navy) 0%, #1a1f4a 100%);
            border: none;
            border-radius: 12px;
            padding: 14px 24px;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.25s ease;
            box-shadow: 0 4px 16px rgba(15, 19, 48, 0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            color: var(--fp-pale);
            cursor: pointer;
            margin-bottom: 16px;
            position: relative;
            overflow: hidden;
        }

            .fp-btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(212, 164, 89, 0.3), transparent);
                transition: left 0.5s ease;
            }

            .fp-btn:hover::before {
                left: 100%;
            }

            .fp-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(15, 19, 48, 0.35);
            }

            .fp-btn:active {
                transform: translateY(0);
            }

            .fp-btn:disabled {
                opacity: 0.7;
                cursor: not-allowed;
                transform: none;
            }

        .fp-btn-icon {
            position: relative;
            z-index: 1;
        }

        .fp-btn-text {
            position: relative;
            z-index: 1;
        }

        .fp-back-link-wrapper {
            text-align: center;
        }

        .fp-back-link {
            color: var(--fp-terracotta);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.2s ease;
            padding: 8px 12px;
            border-radius: 8px;
        }

            .fp-back-link:hover {
                background: rgba(122, 63, 48, 0.08);
                gap: 10px;
                color: var(--fp-clay);
            }

        .fp-back-icon {
            transition: transform 0.2s ease;
        }

        .fp-back-link:hover .fp-back-icon {
            transform: translateX(-3px);
        }

        /* Loading spinner */
        .fp-spinner {
            animation: fp-spin 1s linear infinite;
        }

        keyframes fp-spin {
            from

        {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }

        }

        /* SweetAlert2 custom styling */
        .swal2-popup {
            border-radius: 16px !important;
            font-family: 'Inter', 'Segoe UI', sans-serif !important;
        }

        .swal2-title {
            font-weight: 700 !important;
            font-size: 22px !important;
            color: var(--fp-text-primary) !important;
        }

        .swal2-html-container {
            color: var(--fp-text-secondary) !important;
        }

        .swal2-confirm {
            background: linear-gradient(135deg, var(--fp-navy) 0%, #1a1f4a 100%) !important;
            border-radius: 10px !important;
            padding: 10px 28px !important;
            font-weight: 600 !important;
            box-shadow: 0 4px 12px rgba(15, 19, 48, 0.25) !important;
        }

            .swal2-confirm:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(15, 19, 48, 0.35) !important;
            }

        /* Responsive */
        media (max-width: 576px) {
            .fp-container

        {
            margin: 20px auto;
        }

        .fp-header {
            padding: 32px 24px;
        }

        .fp-header-icon {
            width: 70px;
            height: 70px;
        }

            .fp-header-icon i {
                font-size: 32px;
            }

        .fp-header-title {
            font-size: 24px;
        }

        .fp-body {
            padding: 32px 24px;
        }

        .fp-input {
            padding: 12px 16px;
            font-size: 14px;
        }

        .fp-btn {
            padding: 12px 20px;
            font-size: 15px;
        }

        }
    </style>
</head>
<body class="fp-page">
    <div class="fp-container">
        <div class="fp-card">
            <div class="fp-header">
                <div class="fp-header-icon">
                    <i class="fas fa-key"></i>
                </div>
                <h3 class="fp-header-title">Quên Mật Khẩu</h3>
                <p class="fp-header-subtitle">Nhập email để nhận mã OTP</p>
            </div>

            <div class="fp-body">
                <div class="fp-info-box">
                    <i class="fas fa-info-circle fp-info-icon"></i>
                    <p class="fp-info-text">
                        Chúng tôi sẽ gửi mã OTP (6 số) đến email của bạn.
                        Mã có hiệu lực trong 5 phút.
                    </p>
                </div>

                <form id="forgotPasswordForm">
                    <div class="fp-form-group">
                        <label for="email" class="fp-label">
                            <i class="fas fa-envelope fp-label-icon"></i>
                            Email
                        </label>
                        <input type="email"
                               class="fp-input"
                               id="email"
                               name="email"
                               placeholder="example@email.com"
                               required>
                    </div>

                    <button type="submit" class="fp-btn" id="btnSendOtp">
                        <i class="fas fa-paper-plane fp-btn-icon"></i>
                        <span class="fp-btn-text">Gửi Mã OTP</span>
                    </button>

                    <div class="fp-back-link-wrapper">
                        <a href="/Account/Login" class="fp-back-link">
                            <i class="fas fa-arrow-left fp-back-icon"></i>
                            Quay lại đăng nhập
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.getElementById('forgotPasswordForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const email = document.getElementById('email').value;
            const btn = document.getElementById('btnSendOtp');
            const originalHTML = btn.innerHTML;

            // Disable button
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fp-spinner fp-btn-icon"></i><span class="fp-btn-text">Đang gửi...</span>';

            try {
                const response = await fetch('/Account/SendOtpJson', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ email: email })
                });

                const result = await response.json();

                if (result.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: result.message,
                        timer: 2000,
                        showConfirmButton: false
                    });

                    // Redirect to OTP verification page
                    window.location.href = `/Account/VerifyOtp?email=${encodeURIComponent(email)}`;
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi!',
                        text: result.message
                    });

                    btn.disabled = false;
                    btn.innerHTML = originalHTML;
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: 'Có lỗi xảy ra. Vui lòng thử lại'
                });

                btn.disabled = false;
                btn.innerHTML = originalHTML;
            }
        });
    </script>
</body>
</html>